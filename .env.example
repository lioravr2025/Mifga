# Copy this file to .env.local and fill in the values from your deployed
# Supabase instance (see DEPLOYMENT.md) to run Mifga against a real backend.
# Leave both unset (or delete .env.local) to keep running in local demo mode,
# where everything is stored in the browser's localStorage instead - this is
# the default for `npm run dev` and needs no server at all.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
